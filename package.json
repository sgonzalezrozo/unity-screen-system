      "path": "Samples~/QuickStart"
    }
  ],
  "dependencies": {
    "com.sgonzalezrozo.core": "0.3.0",
    "com.unity.ugui": "1.0.0",
    "com.unity.addressables": "1.21.21",
    "com.unity.inputsystem": "1.7.0"
  }
}
