{
  "name": "com.sgonzalezrozo.screen-system",
  "version": "0.4.3",
  "displayName": "Screen System",
  "description": "UI manager for Unity: build screens from reusable, shared layers with automatic draw order, navigate with a back stack, modals and alerts, and unload everything on scene change without leaks. For uGUI and UI Toolkit, with Resources or Addressables.",
  "documentationUrl": "https://github.com/sgonzalezrozo/unity-screen-system#readme",
  "unity": "2022.3",
  "license": "MIT",
  "author": {
    "name": "Santiago González Rozo",
    "url": "https://github.com/sgonzalezrozo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sgonzalezrozo/unity-screen-system.git"
  },
  "keywords": [
    "ui",
    "screen",
    "navigation",
    "ugui",
    "ui-toolkit",
    "unity",
    "unity3d",
    "unity6",
    "unity-package",
    "upm",
    "csharp",
    "gamedev",
    "ui-navigation",
    "screen-manager",
    "ui-manager",
    "navigation-stack",
    "modal",
    "popup",
    "addressables",
    "layers",
    "ui-layers",
    "memory"
  ],
  "samples": [
    {
      "displayName": "Quick Start",
      "description": "Scripts that open a first screen and react to it opening and closing.",
      "path": "Samples~/QuickStart"
    },
    {
      "displayName": "Benchmark",
      "description": "Measures navigation time, allocations, idle cost and memory across scene changes with your own screens.",
      "path": "Samples~/Benchmark"
    }
  ],
  "dependencies": {
    "com.sgonzalezrozo.core": "0.4.0",
    "com.unity.ugui": "1.0.0",
    "com.unity.addressables": "1.21.21",
    "com.unity.inputsystem": "1.7.0",
    "com.unity.modules.screencapture": "1.0.0",
    "com.unity.modules.uielements": "1.0.0"
  }
}
